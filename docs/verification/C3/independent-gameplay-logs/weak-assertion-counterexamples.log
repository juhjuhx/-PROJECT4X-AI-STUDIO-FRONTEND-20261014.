import fs from 'node:fs';import vm from 'node:vm';import assert from 'node:assert/strict';
import {createGame,applyCommand,observe} from './src/core/game.ts';
const source=fs.readFileSync('../evidence/independent-gameplay-logs/reviewed-initial-source.log','utf8');
const start=source.indexOf('    assert.ok(appended.length >= 1);');
const end=source.indexOf("    if (action.type === 'Attack')",start);
const block=source.slice(start,end);
assert.ok(start>=0&&end>start);
const apply=(s,actor,action,id)=>{const r=applyCommand(s,{actor,action,requestId:id,expectedVersion:s.version});assert.ok(r.ok,r.error);return r.state;};
const results=[];
{
 const before=createGame('霧境初航-01');
 const action={type:'Move',unitId:'兵-1',to:{x:5,y:3}};
 let after=apply(before,0,action,'review-move');
 assert.ok(observe(after,0).legalActions.some(a=>a.type==='ResolveRelic'&&a.choice==='intel'));
 // The UI visibly selected intel, but a wrong callback submitted gold; both payloads are core-legal.
 after=apply(after,0,{type:'ResolveRelic',choice:'gold'},'review-wrong-choice');
 const appended=after.history.slice(before.history.length);
 vm.runInNewContext(block,{assert,appended,action,resolvedRelic:true});
 results.push({id:'WRONG_RELIC_CHOICE_PASSES',expectedSelectedChoice:'intel',actualHistory:appended.map(c=>({actor:c.actor,action:c.action})),weakAssertions:'PASS',counterexample:true});
}
{
 const before=createGame('霧境初航-01'),action={type:'EndTurn'};
 let after=apply(before,0,action,'review-end-human');
 after=apply(after,1,{type:'EndTurn'},'review-end-ai');
 after=apply(after,0,{type:'Research',tech:'farm'},'review-unexpected-human');
 const appended=after.history.slice(before.history.length);
 vm.runInNewContext(block,{assert,appended,action,resolvedRelic:false});
 results.push({id:'EXTRA_HUMAN_AFTER_ENDTURN_PASSES',actualHistory:appended.map(c=>({actor:c.actor,action:c.action})),weakAssertions:'PASS',counterexample:true});
}
results.push({id:'COMMAND_BUDGET_UNDERCOUNTS_FORCED_RELIC',loopPolicySteps:220,forcedRelicCommands:1,reportedHumanCommands:220,actualHumanCommands:221,counterexample:source.includes('humanCommands:trace.length')&&source.includes('step < 220')});
console.log(JSON.stringify({sourceSha256:(await import('node:crypto')).createHash('sha256').update(source).digest('hex'),executedAssertionBlock:block,results},null,2));

