 let moved=apply(before,0,action,'review-move');assert.ok(observe(moved,0).legalActions.some(a=>a.type==='ResolveRelic'&&a.choice==='intel'));
 const wrong=apply(moved,0,{type:'ResolveRelic',choice:'gold'},'review-wrong-choice');
 verify('WRONG_RELIC_CHOICE_REJECTED',{appended:wrong.history.slice(before.history.length),action,relicChoice:'intel',humanCommands:0},true);
 const correct=apply(moved,0,{type:'ResolveRelic',choice:'intel'},'review-right-choice');
 verify('CORRECT_RELIC_CHOICE_ACCEPTED',{appended:correct.history.slice(before.history.length),action,relicChoice:'intel',humanCommands:0},false);
 verify('FORCED_RELIC_OVER_220_REJECTED',{appended:correct.history.slice(before.history.length),action,relicChoice:'intel',humanCommands:219},true);
 verify('EXACTLY_220_HUMAN_COMMANDS_ACCEPTED',{appended:correct.history.slice(before.history.length),action,relicChoice:'intel',humanCommands:218},false);
}
{
 const before=createGame('霧境初航-01'),action={type:'EndTurn'};
 let normal=apply(before,0,action,'review-end-human');normal=apply(normal,1,{type:'EndTurn'},'review-end-ai');
 verify('NORMAL_ENDTURN_AND_AI_ACCEPTED',{appended:normal.history.slice(before.history.length),action,relicChoice:null,humanCommands:0},false);
 const wrong=apply(normal,0,{type:'Research',tech:'farm'},'review-unexpected-human');
 verify('EXTRA_HUMAN_AFTER_ENDTURN_REJECTED',{appended:wrong.history.slice(before.history.length),action,relicChoice:null,humanCommands:0},true);
}
console.log(JSON.stringify({sourceSha256:(await import('node:crypto')).createHash('sha256').update(source).digest('hex'),executedAssertionBlock:block,results},null,2));

