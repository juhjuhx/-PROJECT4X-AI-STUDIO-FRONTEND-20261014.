import fs from 'node:fs';import vm from 'node:vm';import assert from 'node:assert/strict';
import {createGame,applyCommand,observe} from './src/core/game.ts';
const source=fs.readFileSync('../evidence/independent-gameplay-logs/reviewed-strengthened-source.log','utf8');
const start=source.indexOf('    assert.ok(appended.length >= 1);');
const end=source.indexOf("    if (action.type === 'Attack')",start);
const block=source.slice(start,end);
const apply=(s,actor,action,id)=>{const r=applyCommand(s,{actor,action,requestId:id,expectedVersion:s.version});assert.ok(r.ok,r.error);return r.state;};
const results=[];
function verify(id,context,shouldReject){let rejected=false,reason=null;try{Function('assert','appended','action','relicChoice','humanCommands',block)(assert,context.appended,context.action,context.relicChoice,context.humanCommands);}catch(e){rejected=true;reason=e.message.split('\n')[0];}assert.equal(rejected,shouldReject);results.push({id,rejected,expectedRejected:shouldReject,reason});}
{
