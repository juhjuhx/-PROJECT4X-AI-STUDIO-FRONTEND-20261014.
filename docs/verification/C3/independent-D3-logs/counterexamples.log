result.cases.push({id:'SELECTOR_NATIVE_CONTRACT_CHANGED',before,after,validSelectorPreserved:document.querySelector('#app').selector==='#app',counterexample:true});
const {WorldMap}=bundle(mapFile);
function renderSite(site){const labels=[],polygonFills=[];const ctx=new Proxy({fillText(text){labels.push(text);}}, {get(t,k){if(k in t)return t[k];return ()=>{};},set(t,k,v){t[k]=v;return true;}});const map=Object.create(WorldMap.prototype);Object.assign(map,{ctx,view:{actor:0},camera:{zoom:1},polygon(points,fill){polygonFills.push(fill);},circle(){}});map.drawSite({x:8,y:4,visibility:'explored',site},{x:0,y:0});return {labels,roofFill:polygonFills[3],flagFill:polygonFills[4]};}
const ownershipCases=[{kind:'own',owner:0},{kind:'known-enemy',owner:1},{kind:'neutral',owner:null},{kind:'unknown'}].map(({kind,...owner})=>({kind,...renderSite({id:'village',kind:'village',name:'聚落1',...owner})}));
assert.equal(ownershipCases.find(x=>x.kind==='unknown').labels[0],'敵方據點');assert.equal(ownershipCases.find(x=>x.kind==='unknown').roofFill,ownershipCases.find(x=>x.kind==='known-enemy').roofFill);
result.cases.push({id:'UNKNOWN_OWNER_ENEMY_PRESENTATION',ownershipCases,counterexample:true,expected:'own / known-enemy / neutral / unknown must branch independently'});
const relocated=renderSite({id:'村莊-0',kind:'village',name:'聚落1',owner:0,centerOf:0});
assert.equal(relocated.labels[0],'曙光城 · 首都');
const capturedEnemyCapital=renderSite({id:'首都-1',kind:'capital',name:'暮星城',owner:0,centerOf:0});
result.cases.push({id:'POLITICAL_CENTER_HARDCODED_NAME',observedName:'聚落1',relocated,capturedEnemyCapital,counterexample:true,expected:'use observed site.name, political center suffix only when centerOf is known'});
const {createGame,applyCommand,observe}=bundle(root+'/project/src/core/game.ts');
let state=createGame('independent-d3-recruit');
const move=observe(state,0).legalActions.find(a=>a.type==='Move'&&a.unitId==='兵-0');
assert.ok(move);let applied=applyCommand(state,{actor:0,requestId:'review-move',expectedVersion:state.version,action:move});assert.ok(applied.ok);state=applied.state;
applied=applyCommand(state,{actor:0,requestId:'review-end',expectedVersion:state.version,action:{type:'EndTurn'}});assert.ok(applied.ok);state=applied.state;
const view=observe(state,0),tile=view.tiles.find(t=>t.site?.id===view.faction.centerId),site=tile.site;
const inferenceSource=main.match(/const occupyingUnit = view\.units\.find[^\n]+\n\s+const canRecruitAny =[^\n]+\n\s+const siteRecruited =[^\n]+/)[0];
const {occupyingUnit,canRecruitAny,siteRecruited}=vm.runInNewContext(inferenceSource+'\n({occupyingUnit: !!occupyingUnit,canRecruitAny,siteRecruited})',{view,tile,site});
assert.equal(state.sites.find(s=>s.id===site.id).recruited,false);assert.equal(siteRecruited,true);
result.cases.push({id:'RECRUIT_REASON_FALSE_DURING_OPPONENT_TURN',executedD3Source:inferenceSource,usedRealCommands:[move,{type:'EndTurn'}],active:view.active,gold:view.faction.gold,ownSiteRecruitedCanonical:false,occupyingUnit:!!occupyingUnit,canRecruitAny,D3SiteRecruitedInference:siteRecruited,D3Label:'本回合已徵召',counterexample:true,expected:'action absence does not prove recruitment already happened'});
console.log(JSON.stringify(result,null,2));

