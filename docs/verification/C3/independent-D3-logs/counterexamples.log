function bundle(file){const contents=esbuild.buildSync({entryPoints:[file],bundle:true,write:false,format:'cjs',platform:'node',logLevel:'silent'}).outputFiles[0].text;const module={exports:{}};vm.runInNewContext(contents,{module,exports:module.exports,require,console,structuredClone,TextEncoder,TextDecoder,setTimeout,clearTimeout});return module.exports;}
class NativeElement {
 querySelector(s){if(['','#','.',':'].includes(s.trim()))throw new SyntaxError('Invalid selector '+JSON.stringify(s));return {selector:s};}
