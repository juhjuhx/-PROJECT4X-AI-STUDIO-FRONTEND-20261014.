vm.runInNewContext(esbuild.transformSync(guard,{loader:'ts',format:'cjs'}).code,{window,document,Element:NativeElement,Document:NativeDocument,DocumentFragment:NativeFragment});
let observerCalls=0;
window.addEventListener('error',()=>observerCalls++);
const errorEvent=new Event('error',{cancelable:true});
Object.assign(errorEvent,{message:'TypeError: querySelectorAll failed in first-party HUD',filename:'http://127.0.0.1:5173/src/main.ts',error:new TypeError('querySelectorAll failed in first-party HUD')});
const dispatched=window.dispatchEvent(errorEvent);
assert.equal(errorEvent.defaultPrevented,true);assert.equal(observerCalls,0);assert.equal(dispatched,false);
result.cases.push({id:'GLOBAL_ERROR_FIRST_PARTY',message:errorEvent.message,filename:errorEvent.filename,defaultPrevented:errorEvent.defaultPrevented,laterListenerCalls:observerCalls,expected:'first-party error should remain observable',counterexample:true});
let rejectionObserverCalls=0;
window.addEventListener('unhandledrejection',()=>rejectionObserverCalls++);
const rejectionEvent=new Event('unhandledrejection',{cancelable:true});
Object.assign(rejectionEvent,{reason:{message:'Game UI failed',stack:'TypeError: Game UI failed\n at <anonymous> (http://127.0.0.1:5173/src/main.ts:1:1)'}});
window.dispatchEvent(rejectionEvent);
assert.equal(rejectionEvent.defaultPrevented,true);assert.equal(rejectionObserverCalls,0);
result.cases.push({id:'GLOBAL_REJECTION_ANONYMOUS',reason:rejectionEvent.reason,defaultPrevented:rejectionEvent.defaultPrevented,laterListenerCalls:rejectionObserverCalls,counterexample:true});
const after=selectorInputs.map(selector=>({selector,querySelector:document.querySelector(selector),querySelectorAllLength:document.querySelectorAll(selector).length}));
assert.ok(before.every(x=>x.threw==='SyntaxError'));assert.ok(after.every(x=>x.querySelector===null&&x.querySelectorAllLength===0));
