+    filter: drop-shadow(0 1px 2px rgba(0,0,0,0.15));
+  }
+
+  .header-actions {
+    display: flex;
+    gap: 8px;
+    flex-shrink: 0;
+  }
+
+  /* BOARD & SIDEBAR GRID (DESKTOP) */
+  .board-layout {
+    flex: 1;
+    display: grid;
+    grid-template-columns: minmax(0, 1fr) 350px;
+    gap: 24px;
+    padding: 20px 28px;
+    align-items: start;
+    min-width: 0;
+  }
+
+  .board {
+    min-width: 0;
+    display: flex;
+    flex-direction: column;
+    position: sticky;
+    top: 98px;
+  }
+
+  .map-bar {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    gap: 14px;
+    margin-bottom: 12px;
+    padding: 4px 0;
+  }
+
+  .map-title {
+    display: flex;
+    align-items: center;
+    gap: 12px;
+    flex-wrap: wrap;
+  }
+
+  .map-title h2 {
+    font-size: 18px;
+    font-family: "Songti TC", serif;
+    font-weight: 700;
+    color: var(--ink);
+    display: flex;
+    align-items: center;
+    gap: 6px;
+  }
+
+  .map-title h2::before {
+    content: '🧭';
+    font-size: 16px;
+  }
+
+  .explored-label {
+    background: #e1e5d2;
+    color: #375336;
+    font-size: 12px;
+    font-weight: 600;
+    padding: 3px 10px;
+    border-radius: 12px;
+    border: 1px solid #c2ccaf;
+    font-variant-numeric: tabular-nums;
+    letter-spacing: 0.02em;
+  }
+
+  .map-controls {
+    display: flex;
+    align-items: center;
+    gap: 6px;
+  }
+
+  .map-controls button {
+    padding: 7px 13px;
+    font-size: 13px;
+    background: var(--surface);
+    border-color: #bcc3a7;
+    white-space: nowrap;
+  }
+
+  .map-controls .icon-button {
+    min-width: 44px;
+    font-size: 20px;
+    padding: 6px;
+    font-weight: bold;
+    color: var(--ink);
+  }
+
+  .canvas-wrap {
+    position: relative;
+    border-radius: var(--radius-lg);
+    overflow: hidden;
+    border: 2px solid #28473e;
+    background: #19312c;
+    box-shadow: 0 16px 36px rgba(18, 38, 32, 0.22);
+  }
+
+  .world-canvas {
+    display: block;
+    width: 100%;
+    height: clamp(500px, calc(100dvh - 300px), 940px);
+    cursor: grab;
+    touch-action: none;
+    outline: none;
+  }
+
+  .world-canvas:active {
+    cursor: grabbing;
+  }
+
+  .world-canvas:focus-visible {
+    outline: 3px solid #fbd77f;
+    outline-offset: -3px;
+  }
+
+  .map-caption {
+    display: flex;
+    justify-content: space-between;
+    align-items: center;
+    gap: 12px;
+    font-size: 12px;
+    line-height: 1.5;
+    padding: 10px 4px 0;
+    color: var(--ink-soft);
+  }
+
+  .coordinates {
+    font-variant-numeric: tabular-nums;
+    white-space: nowrap;
+    font-weight: 600;
+    background: #e2e4cf;
+    padding: 2px 8px;
+    border-radius: 4px;
+    border: 1px solid #caced0;
+    color: var(--ink);
+  }
+
+  /* SIDEBAR DECK */
+  .sidebar {
+    display: flex;
+    flex-direction: column;
+    gap: 16px;
+    min-width: 0;
+    max-height: calc(100dvh - 210px);
+    overflow-y: auto;
+    padding-right: 6px;
+    scrollbar-width: thin;
+    scrollbar-color: #b7c1a5 transparent;
+  }
+
+  .sidebar::-webkit-scrollbar {
+    width: 6px;
+  }
+  .sidebar::-webkit-scrollbar-thumb {
+    background: #b7c1a5;
+    border-radius: 3px;
+  }
+
+  .panel-section {
+    background: var(--surface);
+    border: 1px solid var(--line);
+    border-radius: var(--radius);
+    padding: 18px;
+    box-shadow: var(--shadow-sm);
+  }
+
+  .panel-section h2 {
+    margin-bottom: 14px;
+    padding-bottom: 8px;
+    border-bottom: 1.5px solid var(--line-soft);
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+  }
+
+  .faction-panel {
+    background: linear-gradient(135deg, #f7f3e8 0%, #ede8d4 100%);
+    border-color: #b8c1a6;
+  }
+
+  .faction-panel h2 {
+    font-family: "Songti TC", "Noto Serif TC", serif;
+    font-size: 22px;
+    color: var(--ink);
+    border-bottom: 0;
+    padding-bottom: 0;
+  }
+
+  .faction-panel .muted {
+    font-size: 13px;
+    line-height: 1.6;
+    margin-top: 10px;
+    color: var(--ink-soft);
+  }
+
+  .inspect-panel {
+    border: 1.5px solid #aebaa0;
+    background: #e8ecda;
+    border-radius: var(--radius);
+    box-shadow: 0 4px 14px rgba(28, 53, 45, 0.08);
+  }
+
+  .inspect-panel h2 {
+    color: #204134;
+  }
+
+  /* STICKY BOTTOM TURN BAR */
+  .turn-bar {
+    padding: 14px 28px calc(14px + env(safe-area-inset-bottom));
+    background: var(--surface-glass);
+    backdrop-filter: blur(14px);
+    border-top: 1px solid var(--line);
+    display: flex;
+    align-items: center;
+    gap: 20px;
+    position: sticky;
+    bottom: 0;
+    z-index: 30;
+    box-shadow: 0 -4px 18px rgba(28, 53, 45, 0.07);
+  }
+
+  .turn-status {
+    min-width: 0;
+    flex: 1;
+  }
+
+  .turn-status strong {
+    font-size: 16px;
+    font-weight: 750;
+    color: var(--ink);
+    display: inline-flex;
+    align-items: center;
+    gap: 8px;
+  }
+
+  .turn-status strong::before {
+    content: '';
+    display: inline-block;
+    width: 9px;
+    height: 9px;
+    border-radius: 50%;
+    background: #479e5d;
+    box-shadow: 0 0 8px rgba(71, 158, 93, 0.6);
+  }
+
+  .status-message {
+    color: var(--ink-soft);
+    font-size: 13px;
+    margin-top: 4px;
+    font-weight: 500;
+  }
+
+  .deck-nav {
+    display: none;
+  }
 }
 
