+    font-size: 12px;
+    background: #edf1e1;
+    min-height: 44px;
+    font-variant-numeric: tabular-nums;
+  }
+
+  .tile-line {
+    font-size: 12px;
+    color: #55664d;
+    margin-top: 12px;
+    border-top: 1px solid #c2cbae;
+    padding-top: 10px;
+    font-weight: 500;
+  }
+
+  .site-block {
+    margin-top: 14px;
+    background: rgba(255, 255, 255, 0.65);
+    padding: 12px;
+    border-radius: 8px;
+    border: 1px solid #bcc6ab;
+  }
+
+  .site-block h3 {
+    margin-bottom: 5px;
+    color: #1e3b2e;
+  }
+
+  .site-block .muted {
+    font-size: 12px;
+    line-height: 1.5;
+  }
+
+  .site-block > button {
+    margin-top: 10px;
+    width: 100%;
+  }
+
+  /* GARRISON OCCUPATION ALERT */
+  .garrison-alert {
+    margin-top: 10px;
+    padding: 12px;
+    background: #fdf5ea;
+    border: 1px solid #d9a857;
+    border-radius: var(--radius-sm);
+    display: flex;
+    flex-direction: column;
+    gap: 6px;
+  }
+
+  .garrison-badge {
+    font-size: 12px;
+    font-weight: 700;
+    color: #8c5211;
+  }
+
+  .garrison-text {
+    font-size: 12px;
+    color: var(--ink);
+    margin: 0;
+  }
+
+  .garrison-warn {
+    font-size: 12.5px;
+    font-weight: 700;
+    color: #9c3f32;
+    margin: 2px 0 6px 0;
+  }
+
+  .recruit-guide-banner {
+    margin-top: 10px;
+    padding: 10px 12px;
+    background: #f7faee;
+    border: 1px solid #9db57d;
+    border-radius: var(--radius-sm);
+    font-size: 12px;
+    color: #2b5536;
+    font-weight: 650;
+  }
+
+  /* RECRUITMENT SECTION */
+  .recruit-section {
+    margin-top: 12px;
+    display: flex;
+    flex-direction: column;
+    gap: 8px;
+  }
+
+  .recruit-header {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    border-bottom: 1px solid var(--line-soft);
+    padding-bottom: 6px;
+  }
+
+  .recruit-header h4 {
+    font-size: 13px;
+    color: var(--ink);
+    font-family: "Songti TC", "Noto Serif TC", serif;
+  }
+
+  .recruit-meta {
+    font-size: 11px;
+    color: var(--ink-subtle);
+  }
+
+  .recruit-list {
+    display: flex;
+    flex-direction: column;
+    gap: 8px;
+  }
+
+  .recruit-card {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    gap: 10px;
+    padding: 10px 12px;
+    background: rgba(255, 255, 255, 0.6);
+    border: 1px solid #c9d0b9;
+    border-radius: var(--radius-sm);
+  }
+
+  .recruit-info {
+    display: flex;
+    flex-direction: column;
+    gap: 2px;
+    min-width: 0;
+  }
+
+  .recruit-info strong {
+    font-size: 13px;
+    color: var(--ink);
+  }
+
+  .recruit-stats {
+    font-size: 11px;
+    color: var(--ink-soft);
+    font-variant-numeric: tabular-nums;
+  }
+
+  .recruit-card button {
+    min-width: 110px;
+    font-size: 12px;
+    padding: 8px 10px;
+    min-height: 44px;
+    flex-shrink: 0;
+  }
+
+  .full-width {
+    width: 100%;
+  }
+
+  .small-button {
+    font-size: 12px;
+    padding: 8px 12px;
+    font-weight: 650;
+    border: 1px solid var(--line);
+    min-height: 44px;
+  }
+
+  .unit-list {
+    display: flex;
+    flex-direction: column;
+    gap: 8px;
+    max-height: 290px;
+    overflow-y: auto;
+  }
+
+  .unit-row {
+    width: 100%;
+    display: flex;
+    align-items: center;
+    text-align: left;
+    gap: 12px;
+    padding: 10px 12px;
+    border: 1px solid transparent;
+    background: rgba(255, 255, 255, 0.45);
+    border-radius: 8px;
+    min-height: 48px;
+  }
+
+  .unit-row:hover {
+    background: #edf1e1;
+    border-color: #b6c3a1;
+  }
+
+  .unit-row.selected {
+    background: #d8e2c4;
+    border-color: #92a478;
+    box-shadow: 0 2px 6px rgba(28, 53, 45, 0.1);
+  }
+
+  .unit-glyph {
+    display: grid;
+    place-items: center;
+    width: 34px;
+    height: 34px;
+    border-radius: 50%;
+    border: 1.5px solid #8e9e7b;
+    color: #27432b;
+    background: #f7f9f0;
+    font-family: "Songti TC", serif;
+    font-size: 16px;
+    font-weight: bold;
+    flex-shrink: 0;
+  }
+
+  .unit-copy {
+    display: grid;
+    gap: 3px;
+    min-width: 0;
+  }
+
+  .unit-copy strong {
+    font-size: 13.5px;
+    color: var(--ink);
+  }
+
+  .unit-copy > span {
+    font-size: 11.5px;
+    font-weight: 500;
+    color: var(--ink-soft);
+    font-variant-numeric: tabular-nums;
+  }
+
+  .unit-ready {
+    margin-left: auto;
+    color: #375b31;
+    font-size: 11px;
+    white-space: nowrap;
+    font-weight: 700;
+    background: #e4eee0;
+    padding: 2px 8px;
+    border-radius: 4px;
+    border: 1px solid #bdd1b6;
+  }
+
+  .unit-ready.spent {
+    color: #7b8577;
+    background: #eceee8;
+    border-color: #d1d5cb;
+  }
+
+  /* TECH RESEARCH PANEL */
+  .tech-overview {
+    padding-bottom: 10px;
+    border-bottom: 1px solid var(--line-soft);
+    margin-bottom: 8px;
+  }
+
+  .tech-overview p {
+    font-size: 12px;
+    color: var(--ink-soft);
+  }
+
+  .tech-row {
+    display: flex;
+    gap: 14px;
+    align-items: center;
+    padding: 12px 0;
+    border-top: 1px solid var(--line-soft);
+  }
+
+  .tech-row:first-of-type {
+    border-top: 0;
+  }
+
+  .tech-copy {
+    flex: 1;
+    position: relative;
+    padding-left: 28px;
+  }
+
+  .tech-title-row {
+    display: flex;
+    align-items: center;
+    gap: 8px;
+    margin-bottom: 3px;
+  }
+
+  .tech-number {
+    position: absolute;
+    left: 0;
+    top: 2px;
+    color: var(--copper);
+    font-family: Georgia, serif;
+    font-size: 13px;
+    font-weight: bold;
+  }
+
+  .tech-title-row h3 {
+    margin: 0;
+    color: var(--ink);
+    font-size: 14.5px;
+  }
+
+  .tech-researched-seal {
+    font-size: 11px;
+    color: #2e663f;
+    font-weight: 700;
+  }
+
+  .tech-copy p {
+    color: var(--ink-soft);
+    font-size: 12px;
+    line-height: 1.5;
+    margin: 0;
+  }
+
+  .tech-row button {
+    min-width: 90px;
+    font-size: 12px;
+    padding: 8px 10px;
+    min-height: 44px;
+    flex-shrink: 0;
+  }
+
+  .tech-row.researched button {
+    background: #e2ede5;
+    border-color: #a8cdb4;
+    color: #275635;
+  }
+
+  /* FUTURE TECH ROADMAP CONCEPT */
+  .tech-roadmap {
+    margin-top: 16px;
+    padding-top: 12px;
+    border-top: 1px dashed var(--line);
+  }
+
+  .tech-roadmap h4 {
+    font-size: 12px;
+    color: var(--ink-subtle);
+    margin-bottom: 8px;
+    font-family: "Songti TC", "Noto Serif TC", serif;
+  }
+
+  .tech-concept-item {
+    display: flex;
+    flex-direction: column;
+    gap: 2px;
+    padding: 8px 10px;
+    margin-bottom: 6px;
+    background: rgba(235, 230, 218, 0.5);
+    border: 1px solid #d4d7c6;
+    border-radius: var(--radius-sm);
+  }
+
+  .tech-concept-item strong {
+    font-size: 12px;
+    color: var(--ink-soft);
+  }
+
+  .concept-tag {
+    font-size: 10px;
+    color: #8c764e;
+    font-style: italic;
+  }
+
+  .tech-concept-item p {
+    font-size: 11px;
+    color: var(--ink-subtle);
+    margin: 0;
+    line-height: 1.4;
+  }
+
+  /* JOURNEY CHRONICLE */
+  .journey-entry {
+    font-size: 12px;
+    color: #626e5a;
+    padding: 8px 0;
+    border-top: 1px solid #d4d7c6;
+    line-height: 1.55;
+  }
+
+  .journey-entry.latest {
+    color: var(--ink);
+    font-weight: 600;
+    border-top: 0;
+    padding-top: 0;
+  }
+
+  .journey-entry.latest::before {
+    content: '✦ ';
+    color: var(--copper);
+  }
+
+  /* WINNER OVERLAY BANNER */
+  .winner-banner {
+    position: absolute;
+    top: 40px;
+    left: 50%;
+    transform: translateX(-50%);
+    width: min(500px, calc(100% - 32px));
+    border: 2px solid #ceb873;
+    background: rgba(247, 243, 228, 0.96);
+    backdrop-filter: blur(8px);
+    padding: 28px 24px;
+    border-radius: var(--radius-lg);
+    text-align: center;
+    box-shadow: 0 20px 48px rgba(18, 38, 32, 0.3);
+    z-index: 10;
+  }
+
+  .winner-banner > span {
+    color: var(--copper);
+    font-size: 13px;
+    font-weight: bold;
+    letter-spacing: 0.1em;
+  }
+
+  .winner-banner strong {
+    display: block;
+    font-family: "Songti TC", serif;
+    font-size: 26px;
+    margin: 12px 0;
+    color: var(--ink);
+  }
+
+  .winner-banner p {
+    font-size: 13px;
+    color: var(--ink-soft);
+  }
+
+  /* DIALOGS & MODALS */
+  .game-dialog {
+    width: min(620px, calc(100% - 32px));
+    max-height: calc(100dvh - 40px);
+    margin: auto;
+    padding: 28px;
+    border: 1.5px solid #aeb897;
+    border-radius: var(--radius-lg);
+    background: var(--surface);
+    color: var(--ink);
+    box-shadow: var(--shadow-lg);
+    overflow-y: auto;
+  }
+
+  .game-dialog::backdrop {
+    background: rgba(14, 30, 26, 0.72);
+    backdrop-filter: blur(4px);
+  }
+
+  .dialog-heading {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    gap: 18px;
+    margin-bottom: 16px;
+    border-bottom: 1.5px solid var(--line-soft);
+    padding-bottom: 12px;
+  }
+
+  .dialog-heading h2 {
+    font-family: "Songti TC", serif;
+    font-size: 24px;
+  }
+
+  .dialog-close {
+    font-size: 13px;
+    padding: 8px 14px;
+    min-height: 44px;
+  }
+
+  .save-notice {
+    margin: 16px 0;
+    font-size: 13px;
+    padding: 12px 14px;
+    background: #e5ead6;
+    border: 1px solid #c7d2b6;
+    border-radius: var(--radius-sm);
+    color: #375338;
+    overflow-wrap: anywhere;
+    font-weight: 500;
+  }
+
+  .record-feedback {
+    font-size: 13px;
+    margin-bottom: 14px;
+    padding: 10px 14px;
+    background: #eef1e3;
+    border-radius: var(--radius-sm);
+    border: 1px solid #c4ccb5;
+    overflow-wrap: anywhere;
+    font-weight: 600;
+  }
+
+  .record-feedback:empty {
+    display: none;
+  }
+
+  .record-feedback.is-error {
+    background: var(--danger-soft);
+    border-color: var(--danger-border);
+  }
+
+  .dialog-actions {
+    display: grid;
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+    gap: 12px;
+  }
+
+  .dialog-section {
+    border-top: 1.5px solid var(--line-soft);
+    margin-top: 24px;
+    padding-top: 20px;
+  }
+
+  .dialog-section h3 {
+    margin-bottom: 8px;
+    font-size: 16px;
+    color: var(--ink);
+  }
+
+  .dialog-section .muted {
+    margin: 6px 0 14px;
+    font-size: 13px;
+  }
+
+  .dialog-section label {
+    display: block;
+    font-size: 13px;
+    font-weight: 600;
+    margin-bottom: 6px;
+  }
+
+  .seed-row {
+    display: grid;
+    grid-template-columns: minmax(0, 1fr) auto;
+    gap: 10px;
+  }
+
+  .replay-result {
+    margin-top: 12px;
+    font-size: 13px;
+    padding: 8px 12px;
+    background: #e8eee2;
+    border-radius: var(--radius-sm);
+    border: 1px solid #b7ccad;
+    overflow-wrap: anywhere;
+    font-weight: 600;
+  }
+
+  .replay-result.is-error {
+    background: var(--danger-soft);
+    border-color: var(--danger-border);
+  }
+
+  .help-steps {
+    margin: 20px 0;
+    padding-left: 20px;
+  }
+
+  .help-steps li {
+    padding-left: 8px;
+    margin-bottom: 16px;
+  }
+
+  .help-steps li::marker {
+    color: var(--copper);
+    font-family: Georgia, serif;
+    font-size: 16px;
+    font-weight: bold;
+  }
+
+  .help-steps strong {
+    font-size: 15px;
+    color: var(--ink);
+  }
+
+  .help-steps p {
+    margin-top: 4px;
+    color: var(--ink-soft);
+    font-size: 13px;
+  }
+
+  .shortcut-help {
+    background: #e4e8d3;
+    border: 1px solid #bec7ad;
+    border-radius: var(--radius-sm);
+    padding: 14px;
+    font-size: 13px;
+    line-height: 1.6;
+    margin-bottom: 16px;
+    font-weight: 500;
+  }
+
+  /* RELIC MODAL */
+  .relic-dialog {
+    text-align: center;
+    border: 2px solid var(--gold);
+    box-shadow: 0 0 50px rgba(216, 183, 98, 0.25), var(--shadow-lg);
+  }
+
+  .relic-art {
+    width: 60px;
+    height: 96px;
+    background: linear-gradient(110deg, #d8dbbf 0 50%, #9caea0 50%);
+    border: 2px solid #b8c49e;
+    transform: skewY(-10deg);
+    margin: 16px auto 28px;
+    position: relative;
+    box-shadow: 0 10px 24px rgba(28, 53, 45, 0.2);
+  }
+
+  .relic-art::before {
+    content: '';
+    position: absolute;
+    height: 32px;
+    width: 5px;
+    top: 24px;
+    left: 25px;
+    background: #ffdf78;
+    box-shadow: 0 0 32px 10px rgba(235, 195, 80, 0.5);
+  }
+
+  .dialog-overline {
+    font-size: 12px;
+    letter-spacing: 0.12em;
+    color: var(--copper);
+    font-weight: bold;
+    text-transform: uppercase;
+  }
+
+  .relic-dialog h2 {
+    font-family: "Songti TC", serif;
+    font-size: 26px;
+    margin: 12px 0;
+    line-height: 1.4;
+    color: var(--ink);
+  }
+
+  .relic-dialog > p {
+    color: var(--ink-soft);
+    font-size: 14px;
+  }
+
+  .relic-choices {
+    display: grid;
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+    gap: 14px;
+    margin: 24px 0 12px;
+  }
+
+  .relic-choice {
+    display: flex;
+    flex-direction: column;
+    gap: 12px;
+    align-items: center;
+    min-height: 172px;
+    padding: 20px 14px;
+    border: 1.5px solid #aebba0;
+    background: #edf1df;
+    border-radius: var(--radius);
+  }
+
+  .relic-choice:hover:not(:disabled) {
+    border-color: var(--copper);
+    background: #f7f9ee;
+    transform: translateY(-2px);
+  }
+
+  .relic-choice > strong {
+    font-size: 16px;
+    color: var(--ink);
+  }
+
+  .relic-choice .choice-value {
+    font-family: Georgia, "Songti TC", serif;
+    font-size: 36px;
+    font-weight: bold;
+    color: var(--copper);
+    line-height: 1;
+  }
+
+  .relic-choice > span:last-child {
+    font-size: 12px;
+    font-weight: 500;
+    line-height: 1.6;
+    color: var(--ink-soft);
+  }
 }
 
