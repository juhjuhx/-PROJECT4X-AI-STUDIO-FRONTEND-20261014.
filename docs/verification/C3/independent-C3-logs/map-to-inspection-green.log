import fs from 'node:fs';import vm from 'node:vm';import assert from 'node:assert/strict';
const source=fs.readFileSync('src/main.ts','utf8');
const snippet=source.slice(source.indexOf('function clickTile('),source.indexOf('function actionLabel(')).replace('point: Point', 'point').replace('): void',')');
const results=[];
for (const initialTab of ['tech','journey']) {
 const context={HUMAN:0,view:{pendingRelic:null,units:[],legalActions:[]},selection:null,activeTab:initialTab,renderCalls:0,selectedUnit:()=>null,canAct:()=>true,dispatch:()=>{throw new Error('unexpected command')},selectUnit:()=>{throw new Error('unexpected own-unit select')}};
 context.render=()=>context.renderCalls++;context.switchTab=tab=>context.activeTab=tab;
 vm.runInNewContext(snippet+'\nclickTile({x:8,y:4});',context);
 results.push({initialTab,afterTab:context.activeTab,selection:context.selection,renderCalls:context.renderCalls,inspectionWouldBeHidden:context.activeTab!=='inspect'});
}
console.log(JSON.stringify({source:'current main.clickTile exact snippet',results},null,2));
assert.ok(results.every(r=>r.afterTab==='inspect'),'selected map cell must reveal inspection on compact tabs');

