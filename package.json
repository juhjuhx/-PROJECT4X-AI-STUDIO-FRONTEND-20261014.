{
  "name": "project-4x-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "check": "tsc --noEmit",
    "start": "node scripts/serve.mjs",
    "context:init": "node scripts/context-init.mjs",
    "qa:headless": "node --import tsx scripts/headless.ts",
    "qa:browser": "node scripts/browser-check.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "vite": "8.3.4",
    "typescript": "7.0.2",
    "tsx": "4.23.15",
    "@types/node": "26.6.5",
    "playwright": "1.64.0"
  }
}
